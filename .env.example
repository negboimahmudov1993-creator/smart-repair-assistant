# ==============================================================================
# Переменные окружения для Vercel и локального запуска
# Скопируйте этот блок или вставьте значения в Vercel: Settings -> Environment Variables
# ==============================================================================

# Ключ Gemini API (получить бесплатно: https://aistudio.google.com/app/apikey)
# Обычно начинается с AIzaSy...
GEMINI_API_KEY=ВСТАВЬТЕ_СЮДА_ВАШ_КЛЮЧ_GEMINI

# URL вашего развернутого приложения на Vercel (для веб и Capacitor APK)
APP_URL=https://umnyj-remontnyj-pomoshhnik-1.vercel.app
VITE_API_URL=https://umnyj-remontnyj-pomoshhnik-1.vercel.app

# Ключ Яндекс Карт (API Кабинет Разработчика Яндекса: https://developer.tech.yandex.ru)
# Формат UUID: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_YANDEX_MAPS_API_KEY=ВСТАВЬТЕ_СЮДА_ВАШ_КЛЮЧ_ЯНДЕКС_КАРТ

# Google Maps API Key (Опционально: оставьте пустым, чтобы работала встроенная карта OpenStreetMap)
VITE_GOOGLE_MAPS_API_KEY=
